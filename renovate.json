{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Our work lives on the cove-patches line, not on main (a stale upstream mirror). A new version-line changes baseBranchPatterns. Patch bundles are merged by the fork's CI check once green; minor and major updates wait for review.",
  "baseBranchPatterns": [
    "cove-patches-v0.30.2"
  ],
  "enabledManagers": [
    "cargo",
    "npm",
    "dockerfile"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/tests/**",
    "docker/Dockerfile",
    "helm/**",
    "**/node_modules/**"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "env": {
    "RUSTC_BOOTSTRAP": "1"
  },
  "dependencyDashboard": true,
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin"
      ],
      "groupName": "Rust patch updates",
      "description": "One weekly bundle per ecosystem and update type: patch bundles can be merged on green CI, minor bundles wait for review."
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Rust minor updates"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin"
      ],
      "groupName": "web patch updates"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "web minor updates"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin"
      ],
      "groupName": "container image patch updates"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "container image minor updates"
    },
    {
      "description": "Digest updates name an exact image or commit with no version to judge, so they always wait for review.",
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "digest updates"
    },
    {
      "description": "Majors get their own PR, so a big jump never hides in a weekly bundle.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Below 1.0, Cargo treats a minor bump (0.5 to 0.6) as breaking, so each gets its own PR like a major, never a place in the minor bundle.",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Patch updates wait 3 days after release (a release with no readable timestamp waits too) and are marked for the CI check's merge step. Renovate itself never automerges.",
      "matchUpdateTypes": [
        "patch",
        "pin"
      ],
      "minimumReleaseAge": "3 days",
      "addLabels": [
        "patch-bundle"
      ],
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "No pre-releases (alpha, beta, rc, pre, dev): an update waits for the stable release. Renovate's ignoreUnstable does not cover a dependency that is already on a pre-release, as rsa 0.10.0-rc.18 is, so this rule names the versions outright.",
      "matchPackageNames": [
        "*"
      ],
      "allowedVersions": "!/-(alpha|beta|rc|pre|dev)([.\\-]?\\d+)*$/"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "labels": [
      "renovate",
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "internalChecksFilter": "strict"
}
